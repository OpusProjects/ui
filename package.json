{
  "name": "unified-ui-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @opusprojects/unified-client && npm run build -w @opusprojects/unified-ui && npm run build -w unified-api-ui",
    "dev": "npm run dev -w unified-api-ui",
    "typecheck": "npm run typecheck --workspaces && tsc -p tests/e2e --noEmit",
    "test:e2e": "playwright test -c tests/e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5"
  }
}
